<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ModularMonolith.Host</RootNamespace>
    <AssemblyName>ModularMonolith.Host</AssemblyName>
    <UserSecretsId>modular-monolith-host-7f3c9a21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.22" />
  </ItemGroup>

  <!--
    The Host is the composition root: it wires the modules together and owns
    the single entry point. It contains NO business logic.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Catalog\ModularMonolith.Modules.Catalog\ModularMonolith.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\Modules\Cart\ModularMonolith.Modules.Cart\ModularMonolith.Modules.Cart.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\ModularMonolith.Modules.Identity\ModularMonolith.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\ModularMonolith.Modules.Inventory\ModularMonolith.Modules.Inventory.csproj" />
    <ProjectReference Include="..\..\Modules\Orders\ModularMonolith.Modules.Orders\ModularMonolith.Modules.Orders.csproj" />
    <ProjectReference Include="..\..\Modules\Payments\ModularMonolith.Modules.Payments\ModularMonolith.Modules.Payments.csproj" />
    <ProjectReference Include="..\..\Shared\Kernel\ModularMonolith.Shared.Kernel\ModularMonolith.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared\Platform\ModularMonolith.Shared.Platform\ModularMonolith.Shared.Platform.csproj" />
  </ItemGroup>

</Project>
