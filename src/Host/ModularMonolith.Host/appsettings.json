{
  "ConnectionStrings": {
    "Sqlite": "Data Source=modular-monolith.db"
  },
  "Jwt": {
    "Issuer": "ModularMonolith",
    "Audience": "ModularMonolith.Client",
    "Key": "development-only-signing-key-change-me-0123456789-abcdefghijkl",
    "ExpirationMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
